# ── Obrigatório em VPS exposta à internet ────────────────────────────────────
# Sem AUTH_TOKEN a API roda SEM autenticação (qualquer um lê/edita/apaga,
# roda código e faz push no git). Gere com: openssl rand -hex 32
AUTH_TOKEN=

# Domínios/IPs aceitos por CORS, separados por vírgula.
# Sem isso, só localhost é aceito (nenhum domínio/IP externo chama a API no browser).
ALLOWED_ORIGINS=https://seu-dominio-ou-ip

# Caminho absoluto do projeto a editar (ex: pasta do Premercado na VPS)
WORKSPACE_PATH=/opt/premercado

# Porta do servidor
PORT=3080

# Pasta onde ficam os backups (.tar.gz) gerados pelo painel
BACKUP_PATH=/opt/backups-premercado

# ── Cuidado ao habilitar ──────────────────────────────────────────────────────
# SHELL_MODE=open remove a whitelist de comandos do /api/shell, roda os
# comandos por um shell de verdade (bash) e libera tudo que um shell faz,
# incluindo encadeamento (; & `` $()) e redirecionamento (>). Só ligue
# temporariamente.
# Sem isto (padrão), comandos rodam SEM shell nenhum -- entre outras coisas,
# ">"/">>" deixam de redirecionar e viram só um argumento literal do comando.
SHELL_MODE=

# ── Opcional: IA no editor (aba de chat) ─────────────────────────────────────
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# ── Opcional: usados pelos botões de "Workflow" (restart/status/health) ──────
# Nome do container de banco (docker) usado no atalho "db-status".
# Default preserva o comportamento anterior (premercado-db-1 / usuário premercado).
DB_CONTAINER_NAME=premercado-db-1
DB_USER=premercado

# Header Host e URL usados no atalho "health". Deixe HEALTH_CHECK_HOST vazio
# para não enviar Host customizado (evita hardcodar domínio de produção aqui).
HEALTH_CHECK_HOST=
HEALTH_CHECK_URL=http://127.0.0.1/api/healthz
