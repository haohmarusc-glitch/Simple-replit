# ── Obrigatório em VPS exposta à internet ────────────────────────────────────
# Sem AUTH_TOKEN a API roda SEM autenticação (qualquer um lê/edita/apaga,
# roda código e faz push no git). Gere com: openssl rand -hex 32
AUTH_TOKEN=

# Domínios/IPs aceitos por CORS, separados por vírgula.
# Sem isso, só localhost é aceito (nenhum domínio/IP externo chama a API no browser).
ALLOWED_ORIGINS=https://seu-dominio-ou-ip

# Caminho absoluto do projeto a editar (ex: pasta do Premercado na VPS)
WORKSPACE_PATH=/opt/premercado

# Porta do servidor
PORT=3080

# Pasta onde ficam os backups (.tar.gz) gerados pelo painel
BACKUP_PATH=/opt/backups-premercado

# ── Cuidado ao habilitar ──────────────────────────────────────────────────────
# SHELL_MODE=open remove a whitelist de comandos do /api/shell e libera
# qualquer comando (incluindo ; & ` $() etc). Só ligue temporariamente.
SHELL_MODE=

# ── Opcional: IA no editor (aba de chat) ─────────────────────────────────────
GROQ_API_KEY=
DEEPSEEK_API_KEY=
